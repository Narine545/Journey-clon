var _hose: MeshInstance3D
var _hose_mat: StandardMaterial3D
var _intake_head: MeshInstance3D
var _intake_mat: StandardMaterial3D

var _vat_fills: Array[MeshInstance3D] = []
var _vat_mats: Array[StandardMaterial3D] = []

