var _steer_visual := 0.0
var _refine_flash := 0.0
var _impact_cooldown := 0.0

var _heave_vel := 0.0
var _pitch_vel := 0.0
var _roll_vel := 0.0

var _trail_buffer := PackedVector4Array()
var _trail_timer := 0.0
var _last_trail_pos := Vector2.ZERO

var _target: ResourceSlick
var _body: Node3D
var _radar: Node3D
var _rudder: Node3D
var _prop_l: Node3D
var _prop_r: Node3D
