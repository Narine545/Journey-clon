static func get_person(id: String) -> Dictionary:
	return PEOPLE.get(id, PEOPLE["netmaker"]) as Dictionary


## Реплика по времени суток и номеру разговора: без повторов подряд.
static func line_for(id: String, hour: float, step: int) -> String:
	var person := get_person(id)
	var key := "day"
	if hour >= 22.0 or hour < 7.0:
		key = "night"
	elif hour >= 18.0:
		key = "dusk"
	var lines: Array = person.get(key, person.get("day", []))
	if lines.is_empty():
		return "…"
	return String(lines[posmod(step, lines.size())])


## Утренняя/вечерняя «сцена» у дома: что человек делает прямо сейчас.
static func scene_for(id: String, hour: float, night01: float) -> String:
	var person := get_person(id)
	var prop := String(person.get("prop", "net"))
	var person_name := String(person.get("name", "")).capitalize()
	if night01 > 0.55:
		match prop:
			"lantern", "lamp":
				return "%s стоит у фонаря и смотрит на воду." % person_name
			"net":
				return "%s вяжет при свете окна." % person_name
			"tray":
				return "%s вытирает кружки, хотя гостей нет." % person_name
			"spyglass":
				return "%s слушает туман с закрытыми глазами." % person_name
			"book":
				return "%s читает список у свечи." % person_name
			_:
				return "%s ещё не спит." % person_name
	match prop:
		"net":
			return "%s растягивает сеть на кольях." % person_name
		"lantern":
			return "%s протирает стекло маячного фонаря." % person_name
		"tray":
			return "%s несёт миску от печи к столу." % person_name
		"bucket":
			return "%s ворочает бочку с солью." % person_name
		"hammer":
			return "%s стучит молотком по горячей латке." % person_name
		"book":
			return "%s замеряет шагом сад." % person_name
		"spyglass":
			return "%s смотрит на бухту в подзорную трубу." % person_name
		"rope":
			return "%s тянет верёвку колокола." % person_name
		"lamp":
			return "%s подрезает фитиль в храме." % person_name
		"crate":
			return "%s выставляет ящики к витрине." % person_name
	return "%s занят своим делом." % person_name
