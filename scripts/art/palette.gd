class_name GiltPalette
extends RefCounted
## «ЗОЛОЧЁНЫЙ ПРИЛИВ» — словарь стиля мира: vaporwave × gothic.
##
## Vaporwave даёт ХОЛОДНЫЙ СВЕТ и широту: хром, бирюзу, розовый неон,
## сиреневые тени, горизонтальную «сетку горизонта». Готика даёт
## МАТЕРИАЛ и вертикаль: чёрный камень, свинцовое стекло, шпили, ниши,
## золото по кромке. Вместе они не спорят, а делят работу:
##   • геометрия, силуэт, тени — готика (высокое, тонкое, резное);
##   • свет, эмаль, отражения — vaporwave (низкое солнце, неон, ореолы).
##
## Правило то же, что у TIDECUT: любой новый предмет посёлка берёт цвета
## отсюда, а не из воздуха. Здесь — только МИР (3D). Интерфейс остаётся
## на TideTokens: бумага и чернила не должны стать неоном.

# --- Камень (готика) ------------------------------------------------------
const BASALT := Color("171a24") # мокрый базальт: стены, цоколь
const BASALT_LIT := Color("2b3042") # тот же камень на солнце
const SLATE := Color("232a38") # шифер, свинцовые крыши
const SLATE_EDGE := Color("3b4660") # кромка шифера, водосток
const LEAD := Color("4a5468") # свинцовый переплёт, кровельные швы
const STONE_COLD := Color("6f7a90") # резной камень, консоли, горгульи

# --- Эмаль и золото ------------------------------------------------------
const GILT := Color("d9b06a") # золото по кромке: шпили, петли, флюгеры
const GILT_HOT := Color("ffd89a") # золото под прямым светом
const ENAMEL_DEEP := Color("16373f") # бирюзовая эмаль в тени
const ENAMEL := Color("2b7f83") # бирюзовая эмаль: двери, ставни
const ENAMEL_LIT := Color("57c9bf") # эмаль на солнце

# --- Стекло и свет (vaporwave) -------------------------------------------
const GLASS_DAY := Color("2a2246") # свинцовое стекло днём: тёмная сирень
const GLASS_NIGHT := Color("ffb0d8") # витраж ночью: розовый неон
const LAMP_WARM := Color("ffd2a1") # тёплый фонарь у двери
const LAMP_NEON := Color("62ffe6") # бирюзовый неон: вывески, окна хаба
const LAMP_MAGENTA := Color("ff6ad5") # розовый неон: акценты, храм
const LAMP_VIOLET := Color("a99bff") # сиреневый: дальние окна, туман

# --- Ткани и мелочь ------------------------------------------------------
const CLOTH := Color("cfc4b4") # выбеленное полотно, паруса тентов
const CLOTH_DYED := Color("7e4a63") # крашеная ткань: бордо в сирени
const ROPE := Color("a2967c") # пенька
const WOOD_DARK := Color("3a2f2a") # мокрое дерево причала
const WOOD_WARM := Color("6b5544") # доска на солнце
const IRON := Color("1d2229") # кованое железо

# --- Земля ---------------------------------------------------------------
const SAND_WARM := Color("c98f5c") # песок посёлка: тёплый, не оранжевый
const SAND_COOL := Color("8f7fa8") # тень песка: сиреневый, не серый
const MOSS := Color("3b4a3a") # мох между камнями

# --- Свет в сцене (значения, а не цвета пикселей) -------------------------
## Ночная заливка: сирень в тенях, бирюза в бликах — два полюса vaporwave.
const NIGHT_FILL := Color("6f7fd4")
const NIGHT_RIM := Color("62ffe6")
const DUSK_KEY := Color("ff9a7a")
const MOON_KEY := Color("a9c2ff")


## Цвет стекла по времени суток: днём тёмная сирень, ночью — неон.
## tint выбирает «краску» конкретного окна (розовый, бирюза, сирень).
static func glass(night01: float, tint: Color = GLASS_NIGHT) -> Color:
	return GLASS_DAY.lerp(tint, clampf(night01, 0.0, 1.0))


## Эмаль/краска под низким солнцем: тень уходит в сирень, свет — в бирюзу.
static func enamel(night01: float, day: Color = ENAMEL, lit: Color = ENAMEL_LIT) -> Color:
	return day.lerp(lit, 0.45 * (1.0 - clampf(night01, 0.0, 1.0)))


## Золото тускнеет к ночи: днём солнце, ночью — отражённый фонарь.
static func gilt(night01: float) -> Color:
	return GILT.lerp(GILT_HOT, 0.5 * (1.0 - clampf(night01, 0.0, 1.0)))
